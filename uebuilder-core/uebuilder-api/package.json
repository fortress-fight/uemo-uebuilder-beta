{
    "name": "@stone/uebuilder-api",
    "version": "4.0.0",
    "description": "UEBuilder 编辑器所需要的公共接口基础库",
    "author": "f-stone <dreamersfly@163.com>",
    "homepage": "",
    "license": "MIT",
    "main": "./api/index.ts",
    "types": "./types/global.d.ts",
    "directories": {
        "lib": "lib",
        "test": "__tests__"
    },
    "files": [
        "lib"
    ],
    "publishConfig": {
        "registry": "https://registry.yarnpkg.com"
    },
    "scripts": {
        "prepare": "HUSKY_DIR=$(pwd)/.husky && cd $(git rev-parse --show-toplevel) && husky \"$HUSKY_DIR\" && echo 'yarn lint-staged' > \"$HUSKY_DIR\"/pre-commit",
        "test": "echo \"Error: run tests from root\" && exit 1",
        "supportedBrowsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > ./lib/supported-browsers.js",
        "supportedBrowsersWin": "(echo export default && browserslist-useragent-regexp --allowHigherVersions) > supportedBrowsers.js"
    },
    "lint-staged": {
        "*.{js,ts,vue}": "eslint --cache --config ./eslint.config.mjs",
        "*.{css,scss,sass,html,vue}": "stylelint --cache",
        "*.**": "prettier --check --ignore-unknown --write --cache"
    },
    "dependencies": {
        "axios": "^1.8.1",
        "axios-cache-interceptor": "^1.8.0"
    },
    "devDependencies": {
        "@stone/eslint-plugin-base": "4.0.0",
        "@stone/stylelint-config-base": "4.0.0",
        "@stone/tsconfig": "4.0.0",
        "@types/crypto-js": "^4.2.2",
        "@types/imagesloaded": "^4.1.6",
        "@types/masonry-layout": "^4.2.8",
        "browserslist-useragent-regexp": "^4.1.0",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "typescript": "^5.3.3"
    },
    "volta": {
        "node": "20.19.0",
        "yarn": "1.22.19"
    }
}

{
    "name": "@stone/uemo-editor-tiptap",
    "version": "4.0.0",
    "description": "用于建立编辑所需的 UI 组件库",
    "author": "ff-stone <stone_fu_work@163.com>",
    "homepage": "",
    "license": "MIT",
    "main": "./src/index",
    "types": "./types/main.d.ts",
    "directories": {
        "lib": "lib",
        "test": "__tests__"
    },
    "files": [
        "lib"
    ],
    "publishConfig": {
        "registry": "https://registry.yarnpkg.com"
    },
    "scripts": {
        "prepare": "HUSKY_DIR=$(pwd)/.husky && cd $(git rev-parse --show-toplevel) && husky \"$HUSKY_DIR\" && echo 'yarn lint-staged' > \"$HUSKY_DIR\"/pre-commit",
        "create-tiptap-element": "node ./cli/create-tiptap-element.mjs",
        "dev": "vue-cli-service serve",
        "inspect": "vue-cli-service inspect > test.js",
        "lint:js": "eslint .",
        "lint:style": "stylelint \"**/*.{css,scss,sass,html,vue}\" --ignore-path .gitignore .stylelintignore",
        "lint:pretter": "prettier . --check --write",
        "lint": "yarn lint:js && yarn lint:style && yarn lint:pretter",
        "lint:fix": "yarn lint:js --fix && yarn lint:style --fix"
    },
    "lint-staged": {
        "*.{js,ts,vue}": "eslint --cache --config ./eslint.config.mjs",
        "*.{css,scss,sass,html,vue}": "stylelint --cache",
        "*.**": "prettier --check --ignore-unknown --write --cache"
    },
    "dependencies": {
        "@inquirer/prompts": "^3.3.0",
        "@stone/uemo-editor-element": "4.0.0",
        "@stone/uemo-editor-page": "4.0.0",
        "@stone/uemo-editor-panel": "4.0.0",
        "@stone/uemo-share-icon-font": "4.0.0",
        "@stone/vue-cli-service": "4.0.0",
        "@tiptap/core": "^3.20.0",
        "@tiptap/extension-bold": "^3.20.0",
        "@tiptap/extension-document": "^3.20.0",
        "@tiptap/extension-dropcursor": "^3.20.0",
        "@tiptap/extension-focus": "^3.20.0",
        "@tiptap/extension-gapcursor": "^3.20.0",
        "@tiptap/extension-hard-break": "^3.20.0",
        "@tiptap/extension-history": "^3.20.0",
        "@tiptap/extension-italic": "^3.20.0",
        "@tiptap/extension-paragraph": "^3.20.0",
        "@tiptap/extension-text": "^3.20.0",
        "@tiptap/extension-text-style": "^3.20.0",
        "@tiptap/extension-typography": "^3.20.0",
        "@tiptap/extensions": "^3.20.0",
        "@tiptap/pm": "^3.20.0",
        "@tiptap/vue-3": "^3.20.0",
        "@types/inquirer": "^9.0.9",
        "change-case": "^5.3.0",
        "commander": "^11.1.0",
        "ejs": "^3.1.9",
        "fast-glob": "^3.3.2",
        "fs-extra": "^11.2.0",
        "linkifyjs": "^4.2.0",
        "vue": "^3.5.13",
        "vue-inline-svg": "^4.0.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@stone/eslint-plugin-base": "4.0.0",
        "@stone/stylelint-config-base": "4.0.0",
        "@stone/tsconfig": "4.0.0",
        "@stone/uebuilder-vue-config": "^4.0.0",
        "@stone/uemo-editor-type": "4.0.0",
        "@stone/uemo-editor-utils": "4.0.0",
        "@stone/vue-cli-plugin-babel": "^4.0.0",
        "@stone/vue-cli-plugin-dll": "4.0.0",
        "@stone/vue-cli-plugin-ejs": "4.0.0",
        "@stone/vue-cli-plugin-normalize-css": "4.0.0",
        "@stone/vue-cli-plugin-sass": "4.0.0",
        "@stone/vue-cli-plugin-svg-sprite": "4.0.0",
        "@stone/vue-cli-plugin-tailwindcss": "4.0.0",
        "@stone/vue-cli-plugin-typescript": "^4.0.0",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.2",
        "typescript": "^5.3.3",
        "unplugin-auto-import": "^0.18.2",
        "unplugin-vue-macros": "^2.10.0"
    },
    "volta": {
        "node": "20.19.0",
        "yarn": "1.22.19"
    }
}
